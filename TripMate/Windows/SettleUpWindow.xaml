<Window x:Class="TripMate.Windows.SettleUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settle Up" Height="460" Width="560" MinHeight="380" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Settle-up plan" FontSize="20" FontWeight="Bold"/>
        <TextBlock DockPanel.Dock="Top" x:Name="summaryText" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="copyButton" Content="Copy Plan" Click="copyButton_Click"/>
            <Button x:Name="recordButton" Content="Record Selected as Paid" Style="{StaticResource PrimaryButton}" Click="recordButton_Click"/>
            <Button Content="Close" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" TextWrapping="Wrap" Margin="0,6"
                   Text="Tick the transfers that have been paid, then click Record Selected as Paid. They are saved as Settlement payments, so the balances update and the spending charts are not affected."/>

        <ListView x:Name="transfersListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Paid?" Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="From" Width="140" DisplayMemberBinding="{Binding Transfer.From}"/>
                    <GridViewColumn Header="To" Width="140" DisplayMemberBinding="{Binding Transfer.To}"/>
                    <GridViewColumn Header="Amount" Width="120" DisplayMemberBinding="{Binding AmountText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
