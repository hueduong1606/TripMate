<Window x:Class="TripMate.Windows.NewTripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Trip" Height="430" Width="480" MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Trip name:"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="tripNameTextBox" Text="Semester break"/>

        <Label Grid.Row="1" Content="Destination:"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="destinationTextBox" TextChanged="destinationTextBox_TextChanged"/>
        <Button Grid.Row="1" Grid.Column="2" x:Name="lookupButton" Content="Look up" Click="lookupButton_Click"/>

        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="locationText" Margin="4,0,4,4"
                   Foreground="Gray" Text="Look up the city to enable weather and attraction search."/>

        <Label Grid.Row="3" Content="Start date:"/>
        <DatePicker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="startDatePicker"/>

        <Label Grid.Row="4" Content="End date:"/>
        <DatePicker Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="endDatePicker"/>

        <Label Grid.Row="5" Content="Settle up in:"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="homeCurrencyComboBox" IsEditable="True"/>

        <Label Grid.Row="6" Content="Local currency:"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="localCurrencyComboBox" IsEditable="True"/>

        <Label Grid.Row="7" Content="Travellers:"/>
        <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="membersTextBox"
                 ToolTip="Names separated by commas, e.g. Ann, Ben, Cat"/>
        <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,0" Foreground="Gray"
                   Text="Names separated by commas, e.g. Ann, Ben, Cat"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="createButton" Content="Create Trip" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="createButton_Click"/>
            <Button x:Name="cancelButton" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>