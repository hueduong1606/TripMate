<Window x:Class="TripMate.Windows.ActivityEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Activity" Height="440" Width="500" MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Name:"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="nameTextBox"/>

        <Label Grid.Row="1" Content="Day:"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="dayComboBox"/>

        <Label Grid.Row="2" Content="Duration (min):"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="durationTextBox"/>

        <Label Grid.Row="3" Content="Find location:"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="searchTextBox"/>
        <Button Grid.Row="3" Grid.Column="2" x:Name="findButton" Content="Find" MinWidth="60" Click="findButton_Click"/>

        <Label Grid.Row="4" Content="Lat / Lon:"/>
        <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="latitudeTextBox"/>
            <TextBox Grid.Column="1" x:Name="longitudeTextBox"/>
            <Button Grid.Column="2" x:Name="clearLocationButton" Content="Clear" MinWidth="60" Click="clearLocationButton_Click"/>
        </Grid>
        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="locationInfoText" Foreground="Gray" TextWrapping="Wrap" Margin="4,0"/>

        <Label Grid.Row="6" Content="Notes:" VerticalAlignment="Top"/>
        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="notesTextBox" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="saveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="saveButton_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>