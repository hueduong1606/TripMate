<Window x:Class="TripMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TripMate - Group Travel Planner" Height="800" Width="1250"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <DockPanel>

        <!-- Top bar: choose a trip -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="10,6">
            <DockPanel>
                <TextBlock Text="TripMate" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Label Content="Trip:" Foreground="White"/>
                <ComboBox x:Name="tripComboBox" Width="420" SelectionChanged="tripComboBox_SelectionChanged"/>
                <Button x:Name="newTripButton" Content="New Trip" Click="newTripButton_Click"/>
                <Button x:Name="deleteTripButton" Content="Delete Trip" Click="deleteTripButton_Click"/>

                <Button x:Name="sampleTripButton" Content="Add Sample Trip" Click="sampleTripButton_Click"/>
                <TextBlock x:Name="tripSummaryText" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="mainTabs" Margin="6" IsEnabled="False" SelectionChanged="mainTabs_SelectionChanged">

            <!-- ===================== GROUP ===================== -->
            <TabItem Header="Group">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Travellers">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom">
                                <TextBox x:Name="memberNameTextBox"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="addMemberButton" Content="Add" Click="addMemberButton_Click"/>
                                    <Button x:Name="removeMemberButton" Content="Remove selected" Click="removeMemberButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox x:Name="membersListBox" FontSize="14"/>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Trip overview">
                        <StackPanel>
                            <TextBlock x:Name="overviewTitleText" FontSize="22" FontWeight="Bold" Margin="4"/>
                            <TextBlock x:Name="overviewText" FontSize="14" Margin="4" TextWrapping="Wrap" LineHeight="24"/>
                            <TextBlock Margin="4,16,4,4" TextWrapping="Wrap" Foreground="Gray"
                                       Text="Tip: add everyone in the group first, then plan the itinerary and log expenses as you go. The Expenses tab works out who owes whom with the fewest transfers."/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ===================== ITINERARY ===================== -->
            <TabItem Header="Itinerary">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Day plan">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Label Content="Day:"/>
                                <ComboBox x:Name="dayComboBox" Width="200" SelectionChanged="dayComboBox_SelectionChanged"/>
                            </StackPanel>

                            <!-- Route optimisation -->
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource LightBrush}" Padding="8" Margin="0,6,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Getting around by:"/>
                                        <ComboBox x:Name="travelModeComboBox" Width="150" SelectionChanged="travelModeComboBox_SelectionChanged"/>
                                        <Button x:Name="optimiseButton" Content="Optimise Route" Style="{StaticResource PrimaryButton}" Click="optimiseButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="routeResultText" TextWrapping="Wrap" Margin="4"
                                               Text="The first stop of the day stays in place (e.g. your hostel). The other stops are re-ordered to cut travel time."/>
                                </StackPanel>
                            </Border>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                <Button x:Name="moveUpButton" Content="Move Up" Click="moveUpButton_Click"/>
                                <Button x:Name="moveDownButton" Content="Move Down" Click="moveDownButton_Click"/>
                                <Button x:Name="removeActivityButton" Content="Remove" Click="removeActivityButton_Click"/>
                            </StackPanel>

                            <ListView x:Name="activitiesListView">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Order}"/>
                                        <GridViewColumn Header="Activity" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Minutes" Width="70" DisplayMemberBinding="{Binding DurationMinutes}"/>
                                        <GridViewColumn Header="Location" Width="150" DisplayMemberBinding="{Binding LocationText}"/>
                                        <GridViewColumn Header="Notes" Width="200" DisplayMemberBinding="{Binding Notes}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="Add an activity">
                        <StackPanel>
                            <Label Content="Name:"/>
                            <TextBox x:Name="activityNameTextBox"/>
                            <Label Content="Find location (place name or address):"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="findLocationButton" Content="Find" MinWidth="60" Click="findLocationButton_Click"/>
                                <TextBox x:Name="locationSearchTextBox"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Lat:"/>
                                <TextBox x:Name="latitudeTextBox" Width="110"/>
                                <Label Content="Lon:"/>
                                <TextBox x:Name="longitudeTextBox" Width="110"/>
                            </StackPanel>
                            <TextBlock x:Name="foundLocationText" TextWrapping="Wrap" Foreground="Gray" Margin="4,0"/>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Duration (minutes):"/>
                                <TextBox x:Name="durationTextBox" Width="70" Text="60"/>
                            </StackPanel>
                            <Label Content="Notes:"/>
                            <TextBox x:Name="notesTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <Button x:Name="addActivityButton" Content="Add to selected day" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="addActivityButton_Click"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Expenses tab: Person C adds it on day 16 -->

            <!-- ===================== EXPLORE ===================== -->
            <TabItem Header="Explore">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Weather forecast (Open-Meteo)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button x:Name="weatherButton" Content="Get Forecast" Click="weatherButton_Click"/>
                                <TextBlock x:Name="weatherInfoText" VerticalAlignment="Center" Margin="6,0" Foreground="Gray"/>
                            </StackPanel>
                            <DataGrid x:Name="weatherDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='ddd dd MMM'}" Width="100"/>
                                    <DataGridTextColumn Header="Conditions" Binding="{Binding Conditions}" Width="*"/>
                                    <DataGridTextColumn Header="Min °C" Binding="{Binding MinTemp, StringFormat=0}" Width="60"/>
                                    <DataGridTextColumn Header="Max °C" Binding="{Binding MaxTemp, StringFormat=0}" Width="60"/>
                                    <DataGridTextColumn Header="Rain" Binding="{Binding RainText}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Grid.RowSpan="2" Header="Things to see nearby (Wikipedia)">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Label Content="Within:"/>
                                <Slider x:Name="radiusSlider" Width="110" Minimum="1" Maximum="10" Value="5"
                                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" VerticalAlignment="Center"/>
                                <TextBlock Width="40" VerticalAlignment="Center" Margin="4,0"
                                           Text="{Binding Value, ElementName=radiusSlider, StringFormat='{}{0:0} km'}"/>
                                <Label Content="Keyword:"/>
                                <TextBox x:Name="keywordTextBox" Width="120" ToolTip="Optional, e.g. museum, park, beach"/>
                                <Button x:Name="searchAttractionsButton" Content="Search" Click="searchAttractionsButton_Click"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                                <ComboBox x:Name="attractionDayComboBox" Width="170"/>
                                <Button x:Name="addAttractionButton" Content="Add to Itinerary" Style="{StaticResource PrimaryButton}" Click="addAttractionButton_Click"/>
                                <Button x:Name="openAttractionButton" Content="Read More" Click="openAttractionButton_Click"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="attractionInfoText" Foreground="Gray" Margin="4"/>
                            <ListBox x:Name="attractionsListBox" MouseDoubleClick="openAttractionButton_Click"/>
                        </DockPanel>
                    </GroupBox>

                    <!-- Currency converter: Person C adds it on day 18 -->
                </Grid>
            </TabItem>

            <!-- Insights tab: Person C adds it on day 17 -->
        </TabControl>
    </DockPanel>
</Window>